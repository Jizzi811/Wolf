# =============================================================================
# CLOSER – Frontend (.env.local)
# =============================================================================
# Vorlage. Nach `.env.local` kopieren und echte Werte eintragen. Niemals echte
# Secrets committen. API-Secrets gehören ausschließlich serverseitig – niemals
# in NEXT_PUBLIC_-Variablen (Sektion 13).

# --- Voice-Engine -----------------------------------------------------------
# "deepgram" (Standard): Deepgram Voice Agent – KEIN LiveKit, KEIN Worker, läuft
#            komplett in dieser App. Empfohlen (einfach & günstig).
# "livekit": ursprüngliche LiveKit-Variante (separates voice-agent Backend).
NEXT_PUBLIC_VOICE_ENGINE=deepgram

# =============================================================================
# Engine "deepgram" – Deepgram Voice Agent
# =============================================================================
# Nur DIESER Key ist nötig, damit CLOSER hört, denkt und spricht.
# Bleibt serverseitig; der Browser bekommt nur ein kurzlebiges Token.
DEEPGRAM_API_KEY=<your_deepgram_api_key>

# Deutsche Stimme: EXAKTE Deepgram Aura-2 Modell-ID (aus der Deepgram-Konsole).
# z. B. die deutsche "Julius"-Stimme. Format: aura-2-<name>-<sprache>.
CLOSER_DG_VOICE=aura-2-julius-de
# Sprache (ISO 639-1) und STT-Modell.
CLOSER_DG_LANGUAGE=de
CLOSER_DG_LISTEN_MODEL=nova-3
# LLM ("Gehirn"):
#  - "open_ai" (Standard): von Deepgram verwaltet, KEIN Provider-Key nötig,
#    über dein Deepgram-Guthaben abgerechnet.
#  - "groq": läuft über Groq (schnell/günstig). Der Groq-Key bleibt serverseitig
#    im Proxy /api/llm-proxy – NICHT im Browser.
CLOSER_DG_THINK_PROVIDER=open_ai
# Modell: bei open_ai z. B. gpt-4o-mini; bei groq z. B. llama-3.3-70b-versatile.
CLOSER_DG_THINK_MODEL=gpt-4o-mini

# --- Groq als Gehirn (nur wenn CLOSER_DG_THINK_PROVIDER=groq) ----------------
# Groq-Key bleibt serverseitig. Neuen Key verwenden, falls der alte je sichtbar war!
GROQ_API_KEY=<your_groq_api_key>
# Optionaler leichter Schutz des Proxys (empfohlen): frei wählbares Geheimnis.
GROQ_PROXY_SECRET=
# Nur nötig, falls die automatische App-URL-Erkennung fehlschlägt (Proxy-URL):
# CLOSER_APP_URL=https://deine-app.example.app

# =============================================================================
# Engine "livekit" – nur nötig, wenn NEXT_PUBLIC_VOICE_ENGINE=livekit
# =============================================================================
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
# Muss zum Agentennamen des Backends passen (voice-agent, ServerOptions.agentName).
AGENT_NAME=CLOSER
# Token-Route (/api/token): zum harten Sperren auf "true" setzen.
LIVEKIT_TOKEN_ROUTE_DISABLED=false
# Nur für die LiveKit Cloud Sandbox – sonst leer lassen.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
