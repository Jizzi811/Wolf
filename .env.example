# ============================================================================
#  CLOSER – Frontend (Next.js) – Beispiel-Environment
#  Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
#  NIEMALS echte Secrets committen.
# ============================================================================

# --- Vapi (Sprach-Engine) ---
# ÖFFENTLICHER Vapi-Key (ist für den Browser gedacht – KEIN Secret).
# Zu finden im Vapi-Dashboard unter API Keys ("Public Key").
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional: ID eines im Vapi-Dashboard angelegten Assistenten.
# Wenn gesetzt, wird DIESER Assistent genutzt. Wenn leer, baut die App den
# CLOSER-Assistenten transient aus lib/closer/assistant.ts (empfohlen für Start).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# --- Metadaten (optional) ---
# Absolute Basis-URL der Seite für korrekte Open-Graph-/Canonical-URLs.
NEXT_PUBLIC_SITE_URL=

# HINWEIS: Die Schlüssel für LLM, Stimme und Transkription liegen NICHT hier,
# sondern in deinem Vapi-Dashboard (Provider Keys) – Vapi ist gehostet.
# Der private Vapi-Key wird nur serverseitig gebraucht, falls du Assistenten
# per API erzeugst; für den Standardbetrieb ist er NICHT nötig.

# ============================================================================
#  Admin-Bereich, Statistik, Wissen, Brücke (alles optional – ohne Datenbank
#  läuft die öffentliche Seite mit den Standardwerten weiter)
# ============================================================================

# --- Datenbank (Pflicht für Admin/Team/Mitglieder) ---
# In Vercel: Storage → Neon (Postgres) → "Connect Project" setzt diese Variable
# automatisch. Lokal: Verbindungs-URL aus dem Neon-Dashboard.
DATABASE_URL=

# --- Datei-Uploads (PDF, Word, Audio, Video, Bilder) ---
# In Vercel: Storage → Blob → "Connect Project" setzt diese Variable automatisch.
BLOB_READ_WRITE_TOKEN=

# --- Vapi-Webhook (Gesprächsende-Bericht, Lead-Funktion, offene Fragen) ---
# Frei wählbares, langes Geheimnis. Vapi sendet es als Header x-vapi-secret.
VAPI_WEBHOOK_SECRET=

# --- KI-Helfer (optional) ---
# Transkription von Audio/Video (Whisper), KI-Vorschläge für Wissensabschnitte,
# automatische Gesprächszusammenfassungen. Ohne Schlüssel: PDF/Word/Text funktionieren.
OPENAI_API_KEY=
# Optional anderes Textmodell für Vorschläge/Zusammenfassungen (Standard gpt-4o-mini).
OPENAI_TEXT_MODEL=

# --- Stimmenliste im Admin (optional) ---
# Zeigt alle Stimmen deines ElevenLabs-Kontos (auch geklonte) mit Hörprobe.
# Derselbe Schlüssel muss im Vapi-Dashboard unter "Provider Keys" liegen.
ELEVENLABS_API_KEY=

# --- Plattform-Brücke (Paket P18 der PHP-Plattform) ---
# KCC_BRIDGE_URL ohne "?route=". Schlüssel aus Plattform-Admin → "CLOSER-Anbindung".
KCC_BRIDGE_URL=https://portal.kickstartercash.club/api/closer/index.php
KCC_BRIDGE_SECRET=

# --- Optional ---
# Schützt den täglichen Abgleich (/api/bridge/sync) per Vercel-Cron.
CRON_SECRET=
# Fester Schlüssel für Login-Sitzungen. Leer = wird einmalig erzeugt und in
# der Datenbank gespeichert (Einstellung auth.secret).
AUTH_SECRET=
