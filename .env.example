# ============================================================================
#  CLOSER – Frontend (Next.js) – Beispiel-Environment
#  Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
#  NIEMALS echte Secrets committen.
# ============================================================================

# --- Vapi (Sprach-Engine) ---
# ÖFFENTLICHER Vapi-Key (ist für den Browser gedacht – KEIN Secret).
# Zu finden im Vapi-Dashboard unter API Keys ("Public Key").
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional: ID eines im Vapi-Dashboard angelegten Assistenten.
# Wenn gesetzt, wird DIESER Assistent genutzt. Wenn leer, baut die App den
# CLOSER-Assistenten transient aus lib/closer/assistant.ts (empfohlen für Start).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# --- Metadaten (optional) ---
# Absolute Basis-URL der Seite für korrekte Open-Graph-/Canonical-URLs.
NEXT_PUBLIC_SITE_URL=

# HINWEIS: Die Schlüssel für LLM, Stimme und Transkription liegen NICHT hier,
# sondern in deinem Vapi-Dashboard (Provider Keys) – Vapi ist gehostet.
# Der private Vapi-Key wird nur serverseitig gebraucht, falls du Assistenten
# per API erzeugst; für den Standardbetrieb ist er NICHT nötig.
