# =============================================================================
# CLOSER – Frontend (.env.local)
# =============================================================================
# Diese Datei ist nur eine Vorlage. Kopiere sie nach `.env.local` und trage
# echte Werte ein. Niemals echte Secrets committen. API-Secrets gehören
# ausschließlich serverseitig – niemals in NEXT_PUBLIC_-Variablen (Sektion 13).

# --- LiveKit-Serverzugang (serverseitig, für die Token-Route) ---------------
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# --- Agent-Dispatch ---------------------------------------------------------
# Muss zum Agentennamen des Backends passen (voice-agent, ServerOptions.agentName).
# Leer lassen für automatischen Dispatch, oder z. B. "CLOSER" für expliziten Dispatch.
AGENT_NAME=CLOSER

# --- Token-Route ------------------------------------------------------------
# Die Token-Route (/api/token) gibt LiveKit-Tokens aus und funktioniert auch in
# Produktion. Für einen öffentlichen Launch davor eine Auth-Schicht ergänzen.
# Zum harten Sperren der Route: auf "true" setzen.
LIVEKIT_TOKEN_ROUTE_DISABLED=false

# --- Optional / intern ------------------------------------------------------
# Nur für die LiveKit Cloud Sandbox nötig – für lokale Entwicklung leer lassen.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
