# =============================================
# WOLF – Voice Agent Environment Variables
# =============================================
# Kopiere diese Datei nach `.env.local` und trage deine echten Keys ein.
# NIEMALS echte Keys committen!

# --- Groq (LLM – kostenlos unter console.groq.com) ---
GROQ_API_KEY=<dein_groq_api_key>

# --- Deepgram (STT + TTS – kostenlos unter console.deepgram.com) ---
DEEPGRAM_API_KEY=<dein_deepgram_api_key>

# --- LiveKit (kann entfernt werden, wenn LiveKit komplett raus ist) ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=