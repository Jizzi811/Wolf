# =============================================================================
# CLOSER – Voice-Agent-Backend (voice-agent/.env.local)
# =============================================================================
# Vorlage. Nach `voice-agent/.env.local` kopieren und echte Werte eintragen.
# Niemals echte Secrets committen (Sektion 13).

# --- LiveKit-Serverzugang (erforderlich) ------------------------------------
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>

# --- Agentenname ------------------------------------------------------------
# Muss zum Frontend (AGENT_NAME) passen. Steuert den expliziten Dispatch.
AGENT_NAME=CLOSER

# --- Pipeline-Auswahl -------------------------------------------------------
# "providers" = eigene Anbieter (Deepgram STT + OpenAI LLM + TTS) -> LiveKit nur
#               als Audiotransport, KEINE LiveKit-Inference-Kosten.
# "inference" = alles über LiveKit Inference.
# Leer lassen = automatisch "providers", sobald DEEPGRAM_API_KEY UND
#               OPENAI_API_KEY gesetzt sind, sonst "inference".
CLOSER_PIPELINE=

# --- Provider-Keys (für Pipeline "providers") -------------------------------
# Deepgram = Hören (STT) und optional die Stimme (TTS).
DEEPGRAM_API_KEY=
# OpenAI = Denken (LLM/GPT) und Standard-Stimme (deutschtaugliches TTS).
OPENAI_API_KEY=

# --- Stimme (TTS) -----------------------------------------------------------
# "openai"   = mehrsprachig, deutschtauglich (Standard).
# "deepgram" = Deepgram-Stimme; für Deutsch die exakte Aura-2-Modell-ID setzen.
CLOSER_TTS_PROVIDER=openai
# OpenAI-Stimme: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer
CLOSER_TTS_VOICE=onyx
# CLOSER_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Deepgram-Stimme (nur wenn CLOSER_TTS_PROVIDER=deepgram): exakte Modell-ID,
# z. B. eine deutsche Aura-2-"Julius"-Variante aus der Deepgram-Doku.
# CLOSER_DEEPGRAM_TTS_MODEL=

# --- Modelle (optional; Standardwerte siehe src/config.ts) ------------------
# CLOSER_LLM_MODEL=gpt-4o-mini            # bei "providers": OpenAI-Modell
# CLOSER_STT_MODEL=nova-3                 # bei "providers": Deepgram-Modell
# CLOSER_STT_LANGUAGE=multi

# Für Pipeline "inference" (LiveKit Inference) – KEINE Provider-Keys nötig:
# CLOSER_LLM_MODEL=google/gemma-4-31b-it
# CLOSER_STT_MODEL=deepgram/nova-3
# CLOSER_TTS_MODEL=cartesia/sonic-3
# VOICE_ID=

# --- Sprache & Begrüßung (optional) -----------------------------------------
# CLOSER_LANGUAGE=de
# CLOSER_GREETING=

# --- Lead-Erfassung (Sektion 15) --------------------------------------------
# Standardmäßig deaktiviert. Nur mit echtem, DSGVO-konformem Backend aktivieren.
LEAD_CAPTURE_ENABLED=false

# --- Debug ------------------------------------------------------------------
CLOSER_DEBUG=false
