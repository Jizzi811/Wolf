# =============================================================================
# CLOSER – Voice-Agent-Backend (voice-agent/.env.local)
# =============================================================================
# Vorlage. Nach `voice-agent/.env.local` kopieren und echte Werte eintragen.
# Niemals echte Secrets committen (Sektion 13).

# --- LiveKit-Serverzugang (erforderlich) ------------------------------------
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>

# --- Agentenname ------------------------------------------------------------
# Muss zum Frontend (AGENT_NAME) passen. Steuert den expliziten Dispatch.
AGENT_NAME=CLOSER

# --- Sprachpipeline (optional; Standardwerte siehe src/config.ts) -----------
# Standard nutzt LiveKit Inference – dann sind KEINE separaten Provider-Keys nötig.
# Verfügbare Modelle/Stimmen bitte in der LiveKit-Dokumentation prüfen.
# CLOSER_LLM_MODEL=google/gemma-4-31b-it
# CLOSER_STT_MODEL=deepgram/nova-3
# CLOSER_STT_LANGUAGE=multi
# CLOSER_TTS_MODEL=cartesia/sonic-3

# Stimmen-ID des TTS-Anbieters (KEINE reale Person klonen).
VOICE_ID=

# --- Sprache & Begrüßung (optional) -----------------------------------------
# CLOSER_LANGUAGE=de
# CLOSER_GREETING=

# --- Optionale Provider-Keys ------------------------------------------------
# Nur nötig, wenn statt LiveKit Inference direkte Anbieter-Plugins genutzt werden.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=

# --- Lead-Erfassung (Sektion 15) --------------------------------------------
# Standardmäßig deaktiviert. Nur mit echtem, DSGVO-konformem Backend aktivieren.
LEAD_CAPTURE_ENABLED=false

# --- Debug ------------------------------------------------------------------
CLOSER_DEBUG=false
