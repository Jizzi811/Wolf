{
  "name": "closer-voice-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CLOSER – LiveKit Voice Agent Backend für KickstarterCash.club",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.0",
    "@livekit/agents-plugin-deepgram": "^1.5.5",
    "@livekit/agents-plugin-openai": "^1.5.5",
    "@livekit/agents-plugin-silero": "^1.5.5",
    "@livekit/rtc-node": "^0.13.31",
    "dotenv": "^17.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
